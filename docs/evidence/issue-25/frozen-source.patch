+#[cfg(all(test, windows))]
+mod queue_audio_tests {
+    use super::*;
+
+    #[test]
+    fn parallel_inspection_preserves_full_checks_due_skips_and_read_only_access() {
+        let root = std::env::temp_dir().join(format!(
+            "lexique-queue-inspection-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        let directory = root.join("Lexique-data/data");
+        std::fs::create_dir_all(&directory).unwrap();
+        let path = DatabasePath(directory.join("lexique.sqlite3"));
+        let connection = Connection::open(&path.0).unwrap();
+        lexique_storage::initialize(&connection).unwrap();
+        let inspector = crate::speech_cache::Inspector::new(&path.0).unwrap();
+        for id in 1..=32 {
+            connection.execute("INSERT INTO vocabulary(id,headword,snapshot,notes,created_at,updated_at) VALUES(?1,?2,'{}','',1,1)", rusqlite::params![id, format!("word-{id}")]).unwrap();
+            connection
+                .execute(
+                    "INSERT INTO review_cards(id,vocabulary_id,kind) VALUES(?1,?1,'listening')",
+                    [id],
+                )
+                .unwrap();
+            std::fs::write(
+                root.join(format!("Lexique-data/temp/speech/{id}.ogg")),
+                b"OggSfixture",
+            )
+            .unwrap();
+        }
+        std::fs::remove_file(root.join("Lexique-data/temp/speech/2.ogg")).unwrap();
+        std::fs::write(root.join("Lexique-data/temp/speech/3.ogg"), b"BAD!").unwrap();
+        connection.execute("INSERT INTO review_progress VALUES(4,1,?1)", [r#"{"phase":"review","memory":{"stability":10,"difficulty":5},"last_review_at":900,"due_at":1010}"#]).unwrap();
+        let cards = lexique_storage::review_card_inventory(&connection).unwrap();
+        let skipped = std::collections::HashSet::from([5]);
+        // Readers must not acquire a write transaction while inspecting files.
+        connection.execute_batch("BEGIN IMMEDIATE").unwrap();
+        let (found, due) =
+            inspect_queue_audio(&path, Ok(&inspector), &cards, &skipped, 1000, true).unwrap();
+        assert_eq!(due, Some(1010));
+        assert_eq!(found.len(), 30);
+        assert_eq!(
+            found[0].1.as_ref().unwrap(),
+            &(true, Some(lexique_storage::content_hash(b"OggSfixture")))
+        );
+        assert_eq!(found[1].1.as_ref().unwrap(), &(false, None));
+        assert!(found[2].1.as_ref().unwrap_err().contains("Invalid"));
+        assert!(found.iter().all(|(id, _)| ![4, 5].contains(id)));
+        let (found, due) =
+            inspect_queue_audio(&path, Ok(&inspector), &cards, &skipped, 1000, false).unwrap();
+        assert!(found.is_empty());
+        assert_eq!(due, Some(1010));
+        connection.execute_batch("ROLLBACK").unwrap();
+        drop(inspector);
+        drop(connection);
+        std::fs::remove_dir_all(&root).unwrap();
+    }
+}
