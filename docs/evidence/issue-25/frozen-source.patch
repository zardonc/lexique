@@ -381,0 +445,64 @@ pub enum UndoOutcome {
+type AudioInspection = (i64, Result<(bool, Option<String>), String>);
+
+fn inspect_queue_audio(
+    path: &DatabasePath,
+    inspector: Result<&crate::speech_cache::Inspector, &String>,
+    cards: &[lexique_storage::QueueCard],
+    skipped: &std::collections::HashSet<i64>,
+    now: i64,
+    check_audio: bool,
+) -> Result<(Vec<AudioInspection>, Option<i64>), String> {
+    let listening: Vec<_> = cards
+        .iter()
+        .filter(|card| card.kind == "listening" && !skipped.contains(&card.id))
+        .collect();
+    std::thread::scope(|scope| {
+        let mut workers = Vec::new();
+        let chunk_size = listening.len().div_ceil(16).max(1);
+        // File I/O only: each worker owns its connection, one update owns the safe directory.
+        for chunk in listening.chunks(chunk_size) {
+            workers.push(scope.spawn(move || {
+                let connection = open(path)?;
+                let mut results = Vec::new();
+                let mut next_due: Option<i64> = None;
+                for card in chunk {
+                    let progress = lexique_storage::review_progress(&connection, card.id)
+                        .map_err(|e| e.to_string())?;
+                    if let Some(due) = progress.card.due_at.filter(|due| *due > now) {
+                        next_due = Some(next_due.map_or(due, |previous| previous.min(due)));
+                        continue;
+                    }
+                    if !check_audio {
+                        continue;
+                    }
+                    let found = inspector
+                        .map_err(Clone::clone)
+                        .and_then(|inspector| {
+                            crate::speech_tasks::inspect_word(
+                                &connection,
+                                inspector,
+                                card.vocabulary_id,
+                                now,
+                            )
+                        })
+                        .map(|(audio, hash)| (audio.is_some(), hash));
+                    results.push((card.vocabulary_id, found));
+                }
+                Ok::<_, String>((results, next_due))
+            }));
+        }
+        let mut results = Vec::new();
+        let mut next_due: Option<i64> = None;
+        for worker in workers {
+            let (found, due) = worker
+                .join()
+                .map_err(|_| "Queue audio inspector panicked")??;
+            results.extend(found);
+            if let Some(due) = due {
+                next_due = Some(next_due.map_or(due, |previous| previous.min(due)));
+            }
+        }
+        Ok((results, next_due))
+    })
+}
