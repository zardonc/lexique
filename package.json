{
  "name": "lexique-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "pnpm --filter @lexique/desktop dev",
    "desktop": "pnpm --filter @lexique/desktop tauri dev",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:portable": "pnpm desktop:build --no-bundle && python -X utf8 scripts/package_portable.py",
    "build": "pnpm --filter @lexique/desktop build",
    "typecheck": "pnpm --filter @lexique/desktop typecheck",
    "lint": "pnpm --filter @lexique/desktop lint",
    "test:e2e": "pnpm --filter @lexique/desktop test:e2e",
    "resources:build": "python -X utf8 scripts/dictionary_sample.py build",
    "resources:prepare": "python -X utf8 scripts/dictionary_sample.py prepare target/desktop-dictionary-sample",
    "resources:query": "python -X utf8 scripts/dictionary_sample.py query",
    "test:resources": "python -X utf8 -m unittest discover -s scripts -p test_dictionary_sample.py -v",
    "frequency:prepare": "python -B -X utf8 scripts/frequency_sample.py target/desktop-frequency-v1",
    "test:frequency": "python -B -X utf8 -m unittest discover -s scripts -p test_frequency_sample.py -v",
    "conjugation:build": "python -X utf8 scripts/conjugation_sample.py build",
    "conjugation:prepare": "python -X utf8 scripts/conjugation_sample.py prepare target/desktop-conjugation-v6-stats",
    "conjugation:query": "python -X utf8 scripts/conjugation_sample.py query",
    "conjugation:table": "python -X utf8 scripts/conjugation_sample.py table",
    "test:conjugation": "python -X utf8 -m unittest discover -s scripts -p test_conjugation_sample.py -v",
    "test:build-args": "node --test scripts/test-build-desktop.mjs",
    "test:tooling": "pnpm test:build-args && python -X utf8 -m unittest discover -s scripts -p test_package_portable.py -v && pnpm test:speech:portable && pnpm test:frequency && python -B -X utf8 -m unittest discover -s scripts -p test_check_sherpa.py -v",
    "test:sherpa": "python -B -X utf8 scripts/check_sherpa.py",
    "test:sherpa:smoke": "python -B -X utf8 scripts/check_sherpa.py --smoke",
    "test:speech:portable": "python -X utf8 -m unittest discover -s scripts -p test_speech_portable.py -v",
    "test:speech:cleanup": "python -X utf8 scripts/test_speech_cleanup.py -v",
    "test:speech:cache": "node scripts/test-rust.mjs --speech-cache",
    "test:desktop:lib": "node scripts/test-rust.mjs --desktop-lib",
    "test:docs": "pwsh -NoProfile -File scripts/check-docs.ps1",
    "test:docs:validator": "pwsh -NoProfile -File scripts/test-docs.ps1",
    "rust:check": "cargo check --locked --workspace",
    "rust:fmt": "cargo fmt --all --check",
    "rust:test:build": "pnpm resources:prepare && pnpm conjugation:prepare && pnpm frequency:prepare && cargo test --locked -p lexique-core -p lexique-storage -p lexique-dictionary --no-run",
    "test:rust": "node scripts/test-rust.mjs",
    "mdict:test:build": "cargo test --locked --manifest-path tools/mdict-probe/Cargo.toml --no-run",
    "test:mdict": "node scripts/test-rust.mjs --mdict",
    "wasm:build": "cargo build --locked --release -p lexique-core --target wasm32-unknown-unknown",
    "scheduling:build": "cargo build --locked --release -p lexique-core --example schedule && pnpm wasm:build",
    "test:scheduling": "node scripts/check-scheduling.mjs"
  }
}
